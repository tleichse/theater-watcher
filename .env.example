# Copy to .env and fill in. .env is git-ignored.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Sending the digest (see HOWTO.md). Leave GMAIL_ADDRESS empty to print emails to the console.
# The app password comes from Google Account > Security > App passwords (needs 2-step verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT=
