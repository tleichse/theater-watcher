# Copy to .env and fill in. .env is git-ignored.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Sending the digest through the Gmail API (see HOWTO.md, one-time setup, step 3).
# Leave GMAIL_ADDRESS empty to print emails to the console instead.
GMAIL_ADDRESS=
# One or more addresses, separated by commas. They're sent in Bcc, so readers don't see each other.
DIGEST_RECIPIENTS=
